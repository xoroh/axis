{
  "name": "@xoroh/axis",
  "version": "0.1.2",
  "description": "Unstyled, accessible UI components and native interaction primitives for React Native.",
  "keywords": [
    "react-native",
    "reactjs",
    "react-native-web",
    "primitives",
    "unstyled",
    "unstyled-components",
    "headless",
    "accessibility",
    "a11y",
    "aria",
    "ui-components",
    "components",
    "mobile",
    "ios",
    "android",
    "cross-platform",
    "design-system",
    "base-ui",
    "radix-ui"
  ],
  "license": "MIT",
  "author": "Xoroh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xoroh/axis.git",
    "directory": "packages/axis"
  },
  "homepage": "https://axis.xoroh.org",
  "bugs": "https://github.com/xoroh/axis/issues",
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./models": {
      "import": {
        "types": "./dist/models.d.ts",
        "default": "./dist/models.js"
      },
      "require": {
        "types": "./dist/models.d.cts",
        "default": "./dist/models.cjs"
      },
      "default": "./dist/models.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "bun run build",
    "build": "tsup src/index.ts src/models.ts --format esm,cjs --dts --dts-resolve --external react --external react-native --out-dir dist --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:jest": "jest",
    "check:boundary": "node scripts/check-boundary.mjs",
    "check:readme": "node scripts/check-readme.mjs",
    "check:readme-examples": "node scripts/check-readme-examples.mjs",
    "check:publish": "publint && attw --pack --ignore-rules=no-resolution"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.86 <0.89"
  },
  "devDependencies": {
    "@babel/runtime": "^7.28.0",
    "@react-native/babel-preset": "^0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.0.0",
    "@types/react-native-web": "^0.19.3",
    "jest": "^30.5.2",
    "jsdom": "^28.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.0.0",
    "react-native": "^0.87.1",
    "react-native-web": "0.21.4",
    "react-test-renderer": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "vitest": "^5.0.2"
  }
}
