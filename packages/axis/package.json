{
  "name": "@xoroh/axis",
  "version": "0.0.0",
  "description": "Design-system-neutral, native-first behavior and interaction primitives for React Native.",
  "license": "MIT",
  "author": "Xoroh",
  "repository": {
    "type": "git",
    "url": "https://github.com/xoroh/axis.git",
    "directory": "packages/axis"
  },
  "homepage": "https://github.com/xoroh/axis",
  "bugs": "https://github.com/xoroh/axis/issues",
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --dts-resolve --external react --out-dir dist --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:boundary": "node scripts/check-boundary.mjs",
    "check:publish": "publint && attw --pack --ignore-rules=no-resolution"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.0.0",
    "jsdom": "^28.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "vitest": "^5.0.2"
  }
}
