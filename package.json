{
  "name": "axis-monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.3.8",
  "engines": {
    "bun": ">=1.3.8"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "changeset": "changeset",
    "version-packages": "changeset version",
    "lint": "biome check .",
    "typecheck": "bun run --filter @xoroh/axis typecheck",
    "test": "bun test tests/",
    "test:all": "bun test tests/ && bun run --filter @xoroh/axis test",
    "build": "bun run --filter @xoroh/axis build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.14",
    "@changesets/cli": "^3.0.3",
    "publint": "^0.3.24"
  }
}
