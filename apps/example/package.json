{
  "name": "@xoroh/axis-example",
  "version": "0.0.0",
  "private": true,
  "description": "Runnable Expo demo app for @xoroh/axis — one unstyled demo per component. Never published.",
  "main": "index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check:demos": "node scripts/check-demo-coverage.mjs && node scripts/check-web-bundle.mjs",
    "start": "expo start",
    "check:web": "node scripts/check-web-bundle.mjs"
  },
  "dependencies": {
    "@xoroh/axis": "workspace:*",
    "expo": "^57.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.3.1",
    "react-native": "^0.86.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "babel-preset-expo": "^57.0.0",
    "typescript": "5.9.3"
  }
}
